# Real AI mode. Add your own key locally; never commit .env.
AI_MODE=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional: enables actual video cards. Without it, show topic search links.
YOUTUBE_API_KEY=
# Separate from the original project's port and database.
PORT=5002
# Optional: set a long random string to retain navigation sessions across restarts.
FLASK_SECRET_KEY=
